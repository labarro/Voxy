{
  "name": "voxy-desktop",
  "version": "1.4.0",
  "private": true,
  "description": "Voz e tela entre amigos pela sua rede privada",
  "author": "Voxy",
  "license": "MIT",
  "main": "dist/main/index.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:media": "tsx tests/media.e2e.ts",
    "test:desktop": "tsx tests/desktop.e2e.ts",
    "dist": "npm run build && node scripts/package.mjs",
    "pack": "npm run build && node scripts/package.mjs --dir",
    "format": "prettier --write src tests scripts vite.config.mts",
    "test:packaged": "tsx tests/packaged.e2e.ts",
    "test:dev": "tsx tests/dev.e2e.ts",
    "test:ptt": "tsx tests/pushToTalk.e2e.ts",
    "test:microphone": "tsx tests/microphone.e2e.ts",
    "updates:keygen": "node scripts/update-keys.mjs",
    "updates:export-key": "node scripts/update-keys.mjs --export",
    "test:updater": "node scripts/test-updater.mjs",
    "test:ux": "tsx tests/ux.e2e.ts",
    "test:audio": "tsx tests/audio.e2e.ts",
    "test:social": "tsx tests/social.e2e.ts",
    "test:gallery": "tsx tests/gallery.e2e.ts",
    "test:controls": "tsx tests/voiceControls.e2e.ts",
    "test:capture": "tsx tests/captureAudio.e2e.ts",
    "test:system": "tsx tests/systemFeatures.e2e.ts",
    "test:rooms3d": "tsx tests/room3d.e2e.ts",
    "test:rooms3d:app": "tsx tests/room3d.app.e2e.ts",
    "test:rooms3d:packaged": "tsx tests/room3d.app.e2e.ts --packaged",
    "test:rooms3d:performance": "tsx tests/room3d.performance.ts",
    "assets:rooms3d": "node scripts/room-asset-manifest.mjs",
    "test:rooms3d:visual": "tsx tests/room3d.visual.ts",
    "test:ui": "tsx tests/redesign.e2e.ts",
    "test:ui:packaged": "tsx tests/redesign.e2e.ts --packaged",
    "test:games:pool": "tsx tests/pool.app.match.ts",
    "test:games:truco": "tsx tests/truco.app.ts",
    "test:games:chess": "tsx tests/chess.app.ts",
    "test:games:social": "tsx tests/social3d.app.ts",
    "test:games:visual": "tsx tests/games.visual.ts"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "electron-updater": "6.8.9",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sql.js": "^1.13.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.4.9",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "latest",
    "electron": "44.9.0",
    "electron-builder": "latest",
    "esbuild": "latest",
    "playwright": "latest",
    "prettier": "^3.9.10",
    "tailwindcss": "latest",
    "three": "^0.187.0",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "build": {
    "appId": "dev.voxy.desktop",
    "productName": "Voxy",
    "directories": {
      "output": "release/1.4.0"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false,
      "signtoolOptions": {
        "publisherName": "Voxy"
      },
      "signAndEditExecutable": true
    },
    "nsis": {
      "deleteAppDataOnUninstall": false,
      "perMachine": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "differentialPackage": true,
      "shortcutName": "Voxy",
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "artifactName": "Voxy-Setup-${version}-${arch}.${ext}",
    "publish": {
      "provider": "generic",
      "url": "https://www.devbarros.com/voxy/updates/"
    },
    "executableName": "Voxy"
  }
}
